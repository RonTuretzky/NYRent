{
  "name": "nyrent-cover-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:fork": "playwright test -c fork/playwright.config.ts",
    "gifs:record": "playwright test -c record/record.config.ts",
    "gifs:record:fork": "playwright test -c record/record-fork.config.ts",
    "gifs:assemble": "node record/assemble.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "viem": "2.56.3"
  }
}
